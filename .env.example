# ─────────────────────────────────────────────────────────────────────────────
# Hani Beauty & Hair — environment variables
# Copy to `.env` for local dev. In production set these in your host (Vercel etc).
# ─────────────────────────────────────────────────────────────────────────────

# Database.
#   Local dev (default):  file:./dev.db                (SQLite, zero setup)
#   Production:            postgresql://USER:PASS@HOST:5432/DB?schema=public
#                         (then set `provider = "postgresql"` in prisma/schema.prisma)
#   or libSQL/Turso:      libsql://your-db.turso.io    (+ TURSO_AUTH_TOKEN)
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth v5. REQUIRED. Generate with: openssl rand -base64 33
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# Public base URL of the deployed site (used in emails and canonical tags).
NEXT_PUBLIC_SITE_URL="https://hanibeautyhair.fi"

# Salon locale settings (also stored in the Settings table; env is the bootstrap default).
SALON_TIMEZONE="Europe/Helsinki"
SALON_CURRENCY="EUR"
SALON_LOCALE="fi-FI"

# Transactional email via Resend — https://resend.com/api-keys
# Leave RESEND_API_KEY empty in dev to write emails to ./.mail/ instead of sending.
RESEND_API_KEY=""
EMAIL_FROM="Hani Beauty & Hair <noreply@hanibeautyhair.fi>"
OWNER_NOTIFICATION_EMAIL="owner@hanibeautyhair.fi"

# Seed data — only used by `npm run db:seed` (development). Never rely on these in prod.
SEED_OWNER_EMAIL="owner@hanibeautyhair.fi"
SEED_OWNER_PASSWORD="change-me"

# Optional: rate-limit backend (defaults to in-memory). For serverless use Upstash.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Cron secret for POST/GET /api/cron/notifications (notification queue drain).
CRON_SECRET=""
